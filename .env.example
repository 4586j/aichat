# Copy to .env, then run npm start (or node server.mjs).
# The application loads .env locally; existing environment variables take precedence.
# Never commit actual secrets. Service URLs are saved separately in Settings.
PORT=4317
AGENT_DATA_DIR=./data

# Credentials are read into server memory; configure other fields in Settings.
AI_API_KEY=
MUSIC_API_KEY=
STICKER_API_KEY=
SMTP_PASSWORD=

# Optional SSH forwarding for private media services. Uses an existing SSH config alias.
# Confirm the host fingerprint and configure SSH key/agent authentication first.
# Both ends of every forwarding bind to 127.0.0.1; no service is published to the LAN.
MEDIA_SSH_ENABLED=false
MEDIA_SSH_HOST=
MEDIA_SSH_FORWARDS=4321:4321,11001:10001
