# Copy to .env, then run: node --env-file=.env server.mjs
# npm start does not load .env automatically. Never commit actual secrets.
PORT=4317
AGENT_DATA_DIR=./data

# Credentials are read into server memory; configure other fields in Settings.
AI_API_KEY=
MUSIC_API_KEY=
STICKER_API_KEY=
SMTP_PASSWORD=
